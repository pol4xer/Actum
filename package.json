    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "dev:ios": "bash scripts/dev-ios.sh",
    "ai:server": "node --env-file-if-exists=.env.local scripts/ai-server.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:ai": "node --test test/*.test.mjs",
    "check": "pnpm typecheck && pnpm test:ai && expo export --platform web"
  },
  "private": true
