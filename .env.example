# Copy this file to .env.local and add your own OpenAI API key.
# Keep secrets server-side; EXPO_PUBLIC_* values are embedded in the app bundle.
OPENAI_API_KEY=

# Optional. The server defaults to gpt-5.6; choose a model available to your account.
OPENAI_MODEL=gpt-5.6
# Optional: use another compatible model for the research stage.
OPENAI_RESEARCH_MODEL=gpt-5.6

# For a physical iPhone, replace 127.0.0.1 with your Mac's LAN IP in .env.local.
EXPO_PUBLIC_ACTUM_AI_URL=http://127.0.0.1:8787

# Enables local test controls only while the JavaScript bundle also runs in __DEV__.
# Use production (or omit the variable) for a fail-closed app without DEV controls.
EXPO_PUBLIC_ACTUM_MODE=development

# Only for testing on a physical iPhone over your trusted local network:
# ACTUM_AI_HOST=0.0.0.0

# Optional: link builds to your own Expo/EAS project. Not required for local use.
# Expo CLI loads these from .env.local. Also configure them in your EAS build
# environment when using cloud builds. These identifiers are public build metadata,
# not credentials; never put an API key or token in app configuration.
# ACTUM_EAS_OWNER=your-expo-username
# ACTUM_EAS_PROJECT_ID=your-eas-project-uuid
