# Copy this file to .env.local and add your own OpenAI API key.
OPENAI_API_KEY=

# Optional. The default alias currently points to the latest GPT-5.6 Sol model.
OPENAI_MODEL=gpt-5.6

# For a physical iPhone, replace 127.0.0.1 with your Mac's LAN IP in .env.local.
EXPO_PUBLIC_ACTUM_AI_URL=http://127.0.0.1:8787

# Only for testing on a physical iPhone over your trusted local network:
# ACTUM_AI_HOST=0.0.0.0
